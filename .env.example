PORT=5001
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/goldscheme_prod
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
NODE_ENV=production
FIELD_ENCRYPTION_KEY=64_character_hex_string_here

# Set to false for Production server
MOCK_MODE=false
MOCK_OTP=

# Fast2SMS Credentials (Production)
FAST2SMS_API_KEY=your_live_fast2sms_api_key
FAST2SMS_SENDER_ID=FSTSMS
FAST2SMS_ROUTE=otp

# Razorpay Live Credentials (Production)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# Firebase Push Credentials
FIREBASE_PROJECT_ID=swarna-bindu-fcm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@swarna-bindu-fcm.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# External API Keys
GOLD_API_KEY=goldapi-xxxxxxxxxxxxxxxxxxxxxxxx-io
KYC_API_KEY=kyc_provider_secret_token_here
